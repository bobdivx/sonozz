---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import NowPlayingBar from "../components/NowPlayingBar.jsx";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SONOZZ — Studio de création d'artiste",
  description = "Créez un artiste musical réaliste de A à Z : tendances, paroles, morceaux, jaquettes, Spotify et shorts.",
} = Astro.props;
---

<!doctype html>
<html lang="fr" data-theme="sonozz">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Syne:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <main id="root-app">
      <slot />
    </main>
    <NowPlayingBar client:load transition:persist="sonozz-now-playing" transition:persist-props />
  </body>
</html>
