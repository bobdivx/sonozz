---
import Layout from "../layouts/Layout.astro";

export const prerender = false;

const message =
  Astro.props.error instanceof Error
    ? Astro.props.error.message
    : "Une erreur serveur a interrompu le chargement.";
---

<Layout title="SONOZZ — Erreur" description="Erreur serveur SONOZZ.">
  <div class="mx-auto flex min-h-screen max-w-lg flex-col justify-center px-6 py-12 pb-32">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-error/80">Erreur 500</p>
    <h1 class="font-display mt-3 text-3xl font-bold tracking-tight">Ça a planté côté serveur</h1>
    <p class="mt-3 text-sm leading-relaxed text-base-content/70">
      La page demandée n’a pas pu être générée. Réessaie, ou reviens au studio.
    </p>
    <p class="mt-4 rounded-xl border border-error/25 bg-error/10 px-4 py-3 text-sm text-error/90">
      {message}
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn btn-primary" href="/">Retour au studio</a>
      <a class="btn btn-ghost border border-base-content/15" href="/play">Lecteur public</a>
    </div>
  </div>
</Layout>
