---
import Layout from "../layouts/Layout.astro";
import PlayerPage from "../components/PlayerPage.jsx";
import { listLibraryTracks, listArtists } from "../server/artists.js";

export const prerender = false;

let initialTracks = [];
let initialArtists = [];
try {
  const [tracks, artists] = await Promise.all([
    listLibraryTracks(200),
    listArtists(80, { includeAll: true, fields: "lite" }),
  ]);
  initialTracks = tracks;
  initialArtists = artists;
} catch {
  /* client refetch */
}
---

<Layout
  title="SONOZZ — Play"
  description="Lecteur multimedia SONOZZ : tous les titres, un artiste ou une file d’attente."
>
  <meta name="sonozz-play-rev" content="e118b71-rewrite" />
  <PlayerPage client:load initialTracks={initialTracks} initialArtists={initialArtists} />
</Layout>
