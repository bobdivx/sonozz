---
import Layout from "../layouts/Layout.astro";
import LoginForm from "../components/LoginForm.jsx";
import { getSessionFromCookies } from "../server/auth.js";

const session = getSessionFromCookies(Astro.cookies);
const nextParam = Astro.url.searchParams.get("next") || "/";
const next =
  nextParam.startsWith("/") && !nextParam.startsWith("//") && !nextParam.startsWith("/login")
    ? nextParam
    : "/";

if (session) {
  return Astro.redirect(next);
}
---

<Layout title="SONOZZ — Connexion" description="Connexion au studio SONOZZ.">
  <LoginForm client:load next={next} />
</Layout>
