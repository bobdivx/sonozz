---
import Layout from "../layouts/Layout.astro";

export const prerender = false;

function safeNext(raw) {
  if (!raw || typeof raw !== "string") return "/studio";
  if (!raw.startsWith("/") || raw.startsWith("//")) return "/studio";
  if (raw.startsWith("/login") || raw.startsWith("/403") || raw.startsWith("/signup")) return "/studio";
  return raw;
}

const rawNext = Astro.url.searchParams.get("next") || "/studio";
const next = safeNext(rawNext);
const wantsSignup = String(rawNext).replace(/\/+$/, "") === "/signup";
const loginHref = `/login?next=${encodeURIComponent(next)}`;
const signupHref = `/signup?next=${encodeURIComponent(next === "/studio" && !wantsSignup ? "/studio" : next)}`;
---

<Layout title="SONOZZ — Connexion requise" description="Connexion studio requise.">
  <div class="mx-auto flex min-h-screen max-w-lg flex-col justify-center px-6 py-12 pb-32">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-warning/80">Erreur 403</p>
    <h1 class="font-display mt-3 text-3xl font-bold tracking-tight">Connexion requise</h1>
    <p class="mt-3 text-sm leading-relaxed text-base-content/70">
      Cette page du studio SONOZZ nécessite un compte. L’écoute publique reste ouverte sans connexion.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn btn-primary" href={wantsSignup ? "/signup" : signupHref}>Créer un compte</a>
      <a class="btn btn-ghost border border-base-content/15" href={loginHref}>Se connecter</a>
      <a class="btn btn-ghost border border-base-content/15" href="/play">Ouvrir le lecteur</a>
    </div>
  </div>
</Layout>
