---
import Layout from "../layouts/Layout.astro";
import LandingHome from "../components/LandingHome.jsx";
import { getSessionFromCookies } from "../server/auth.js";
import { getBillingPlans, planBullets, defaultBillingPlans } from "../server/plans.js";

export const prerender = false;

const session = getSessionFromCookies(Astro.cookies);
if (session) {
  const q = Astro.url.search;
  return Astro.redirect(`/studio${q || ""}`);
}

let plans;
try {
  plans = await getBillingPlans();
} catch {
  plans = defaultBillingPlans();
}
const freeBullets = planBullets(plans, "free");
const proBullets = planBullets(plans, "pro");
const publishBullets = planBullets(plans, "publish_plus");
---

<Layout
  title="SONOZZ — Crée ton artiste IA"
  description="Crée ton artiste, génère des titres, publie. Un flux en 3 étapes — sans Docker ni config serveur."
>
  <LandingHome
    client:load
    freeBullets={freeBullets}
    proBullets={proBullets}
    publishBullets={publishBullets}
    plans={plans}
  />
</Layout>
