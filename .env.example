TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_turso_token

# Accès studio (obligatoire en prod). /play reste public.
AUTH_EMAIL=you@example.com
AUTH_PASSWORD=change-me
AUTH_SECRET=generate-a-long-random-string
# Cookies Secure (https) — mettre 1 en production
AUTH_SECURE=1

# Invitations email — Scaleway Transactional Email (TEM)
SMTP_HOST=smtp.tem.scaleway.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Alias accepté : SMTP_PASSWORD (ex. DevForge)
SMTP_FROM="SONOZZ <noreply@example.com>"
# Optionnel : SMTP_SECURE=true (sinon déduit du port 465/2465)
# URL publique pour les liens d’invitation (sinon déduite de la requête)
APP_URL=https://example.com

# Pocket ID (SSO optionnel) — injecté par DevForge, ne pas hardcoder l’issuer
# OIDC_ISSUER / OIDC_ISSUER_URL / OIDC_DISCOVERY_URL
# OIDC_CLIENT_ID / OIDC_CLIENT_SECRET / OIDC_SCOPES
# POCKET_ID_URL
# AUTH_POCKET_ID_ID / AUTH_POCKET_ID_SECRET / AUTH_POCKET_ID_ISSUER
# Callback runtime : {origine}/api/auth/callback/pocket-id

# Stockage clips — Scaleway Object Storage (exemple)
S3_BUCKET=sonozz
S3_REGION=fr-par
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Alias DevForge / Coolify acceptés : SCW_BUCKET, SCW_ACCESS_KEY, SCW_SECRET_KEY, SCW_REGION
# Bucket privé : laisser S3_PUBLIC_URL vide → lecture via /api/audio/stream?key=
# Bucket public : S3_PUBLIC_URL=https://sonozz.s3.fr-par.scw.cloud
# MinIO local uniquement : S3_FORCE_PATH_STYLE=1

# Stripe Checkout (subscriptions) — ne jamais committer de vraies clés
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_PUBLISH_PLUS=price_...   # optionnel
# APP_URL=https://sonozz.briseteia.me
# STRIPE_SUCCESS_URL=https://sonozz.briseteia.me   # optionnel (override base redirects)
